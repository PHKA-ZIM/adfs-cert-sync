# Pflichtfeld: Öffentliche URL zur AD-FS FederationMetadata.xml
ADFS_METADATA_URL=https://fs.beispiel.de/FederationMetadata/2007-06/FederationMetadata.xml

# Zielpfad für das aktuell gültige Signing-Zertifikat (PEM-Format, ohne Historie)
ADFS_CERT_OUTPUT_PATH=./var/adfs_signing_cert.pem

# Optional: HTTP-Timeout in Sekunden
ADFS_REQUEST_TIMEOUT_SECONDS=15

# Optional: Log-Level (DEBUG, INFO, WARNING, ERROR)
ADFS_LOG_LEVEL=INFO

# Optional: Pre-Hook (wird vor dem Metadaten-Abruf ausgeführt)
# ADFS_PRE_HOOK=/opt/adfs-cert-sync/hooks/pre_check.sh

# Optional: Post-Hook (wird nach erfolgreichem Lauf ausgeführt; nutzt z. B. $ADFS_CERT_PATH und $ADFS_CERT_SHA256)
# ADFS_POST_HOOK=/opt/adfs-cert-sync/hooks/post_rollout.sh

# Optional: Post-Hook nur bei geändertem Zertifikat ausführen (true/false)
ADFS_POST_HOOK_ONLY_ON_CHANGE=true

# Optional: Timeout für Pre-/Post-Hooks in Sekunden
ADFS_HOOK_TIMEOUT_SECONDS=60
